{
  "expo": {
    "name": "Coaching",
    "slug": "coaching-mobile",
    "version": "1.0.0",
    "scheme": "coachapp",
    "platforms": [
      "ios",
      "android"
    ],
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Coaching to use the camera to photograph your scale display."
        }
      ],
      "expo-image-picker",
      "expo-notifications",
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Coaching to read your step count to auto-fill today's steps."
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthPermissions",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coachos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.coachos.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2b1203c-0a90-4d4a-99e5-8d7a16546a20"
      }
    },
    "owner": "silver-shadow",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f2b1203c-0a90-4d4a-99e5-8d7a16546a20"
    }
  }
}
