# ── Supabase ────────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by Supabase CLI for local dev and migrations
SUPABASE_DB_PASSWORD=your-db-password

# ── Application ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CoachingPlatform

# ── Stripe (parallel track — do not add until Tier 1B) ──────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email (transactional — Resend) ───────────────────────────────────────────────
# Required for client invite emails (T1-18). Server-side only.
EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_your_resend_api_key

# ── Cron ────────────────────────────────────────────────────────────────────────
# Shared secret authorizing POST /api/flash-cards/compute (T1-09). Server-side only.
CRON_SECRET=your-cron-secret

# ── Coach signup gate (T1-21) ────────────────────────────────────────────────────
# Invitation code required by POST /api/signup. Server-side only — never
# NEXT_PUBLIC_*. Signup fails closed (403) when unset.
SIGNUP_INVITE_CODE=your-signup-invite-code

# ── Push Notifications (PENDING — mobile pilot platform decision required) ───────
# EXPO_PUSH_TOKEN=...

# ── Environment ─────────────────────────────────────────────────────────────────
NODE_ENV=development
